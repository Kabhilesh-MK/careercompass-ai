# ─────────────────────────────────────────────────────
#  CareerCompass AI — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=career_compass_ai

# ── JWT Authentication ────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_64_CHARS_MINIMUM
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (never use wildcard in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ── File Uploads ──────────────────────────────────────
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=5

# ── Application ──────────────────────────────────────
APP_NAME=CareerCompass AI
APP_ENV=production
APP_DEBUG=false

# ── SMTP (optional — for email reports) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@careercompass.ai
