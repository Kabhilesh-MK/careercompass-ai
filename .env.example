# CareerCompass AI Frontend Environment Variables
# Copy this file to .env for local development, or set in Vercel Project Settings for production.

# Backend API Base URL (FastAPI running on Render or local machine)
# Note: Both VITE_API_URL and VITE_API_BASE_URL are supported.
# Local development:
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production deployment on Vercel:
# Set to your deployed Render backend web service URL:
# VITE_API_URL=https://careercompass-api.onrender.com
# VITE_API_BASE_URL=https://careercompass-api.onrender.com

